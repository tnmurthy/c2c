{
  "name": "campus-to-corporate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev\" \".venv\\\\Scripts\\\\python -m uvicorn api.main:app --port 8000\"",
    "dev:test": "concurrently \"next dev -p 3011\" \"call .venv\\\\Scripts\\\\activate.bat && python -m uvicorn api.main:app --port 8011\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "npx kill-port 3011 8011 && playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "lucide-react": "^0.378.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "eslint": {
      "minimatch": {
        "brace-expansion": "^1.1.18"
      }
    },
    "shell-quote": "^1.10.0",
    "lucide-react": {
      "react": "$react"
    }
  }
